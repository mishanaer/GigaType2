# Better Auth (optional account features)
VITE_AUTH_URL=

# Type Cloud API (optional account/sync features)
VITE_OPENWHISPR_API_URL=

# Optional Google OAuth desktop callback override
VITE_OPENWHISPR_OAUTH_CALLBACK_URL=

# Optional release channel override
OPENWHISPR_CHANNEL=

# Optional GigaAM API base override.
# The bundled sidecar normally provides this automatically.
GIGAAM_API_BASE=http://127.0.0.1:8765/v1

# Optional UI language for app interface and menus
UI_LANGUAGE=en

# Optional log level: trace, debug, info, warn, error, fatal
OPENWHISPR_LOG_LEVEL=debug

# --- Release publishing (scripts/publish.py -> SberCloud OBS) ---
# Required to upload build artifacts from dist/ to OBS.
OBS_ENDPOINT=https://obs.ru-moscow-1.hc.sbercloud.ru
OBS_BUCKET=
OBS_REGION=ru-moscow-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: overrides the default prefix
# function_descriptions/gigatype-electron/${OPENWHISPR_CHANNEL:-prod}
OBS_PREFIX=
