{
  "appId": "ai.gigatype.app",
  "afterPack": "scripts/afterPack.js",
  "afterSign": "scripts/afterSign.js",
  "afterAllArtifactBuild": "scripts/afterAllArtifactBuild.js",
  "productName": "Type",
  "protocols": {
    "name": "Type Protocol",
    "schemes": ["gigatype"]
  },
  "directories": {
    "output": "dist"
  },
  "publish": {
    "provider": "generic",
    "url": "https://obs.ru-moscow-1.hc.sbercloud.ru/d-ssdev-crowd/function_descriptions/gigatype-electron/prod",
    "channel": "latest"
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/**/*",
    "src/dist/**/*",
    "src/helpers/**/*",
    "src/config/**/*",
    "src/constants/**/*",
    "src/locales/**/*",
    "src/hooks/**/*",
    "src/models/**/*",
    "src/workers/**/*",
    "src/services/localReasoningBridge.js",
    "src/types/**/*",
    "src/utils.js",
    "src/utils/**/*",
    "src/updater.js",
    "src/components.json",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*",

    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/app-builder-bin/**",
    "!**/node_modules/app-builder-lib/**",
    "!**/node_modules/builder-util/**",
    "!**/node_modules/dmg-builder/**",
    "!**/node_modules/7zip-bin/**",

    "!**/node_modules/typescript/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/eslint/**",
    "!**/node_modules/eslint-*/**",
    "!**/node_modules/@eslint/**",
    "!**/node_modules/@typescript-eslint/**",
    "!**/node_modules/globals/**",

    "!**/node_modules/vite/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/@esbuild/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/@rollup/**",

    "!**/node_modules/postcss/**",
    "!**/node_modules/autoprefixer/**",
    "!**/node_modules/tailwindcss/**",
    "!**/node_modules/@tailwindcss/**",
    "!**/node_modules/lightningcss*/**",

    "!**/node_modules/react/**",
    "!**/node_modules/react-dom/**",
    "!**/node_modules/lucide-react/**",
    "!**/node_modules/@radix-ui/**",
    "!**/node_modules/class-variance-authority/**",
    "!**/node_modules/clsx/**",
    "!**/node_modules/tailwind-merge/**",
    "!**/node_modules/tw-animate-css/**",
    "!**/node_modules/react-markdown/**",
    "!**/node_modules/shadcn-ui/**",

    "!**/node_modules/ffmpeg-static/**",
    "!**/node_modules/ai/**",
    "!**/node_modules/@ai-sdk/openai/**",
    "!**/node_modules/@ai-sdk/anthropic/**",
    "!**/node_modules/@ai-sdk/google/**",
    "!**/node_modules/@ai-sdk/groq/**",
    "!**/node_modules/@ai-sdk/provider/**",
    "!**/node_modules/@ai-sdk/provider-utils/**",
    "!**/node_modules/zod/**",
    "!**/node_modules/@tiptap/**",
    "!**/node_modules/@ffprobe-installer/**",
    "!**/node_modules/@qdrant/**",
    "!**/node_modules/@aws-sdk/**",
    "!**/node_modules/@smithy/**",
    "!**/node_modules/@aws-crypto/**",
    "!**/node_modules/@ai-sdk/amazon-bedrock/**",
    "!**/node_modules/@ai-sdk/azure/**",
    "!**/node_modules/@ai-sdk/google-vertex/**",
    "!**/node_modules/kysely/**",
    "!**/node_modules/better-sqlite3/deps/**",
    "!**/node_modules/better-sqlite3/src/**",
    "!**/node_modules/framer-motion/**",
    "!**/node_modules/motion-dom/**",
    "!**/node_modules/motion/**",
    "!**/node_modules/web-streams-polyfill/**",
    "!**/node_modules/@opentelemetry/**",
    "!**/node_modules/@types/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/cross-env/**",
    "!**/node_modules/@electron/notarize/**",

    "!**/node_modules/node-gyp/**",
    "!**/node_modules/nan/**",
    "!**/node_modules/psl/**",
    "!**/node_modules/ajv/**",
    "!**/node_modules/npmlog/**",
    "!**/node_modules/prebuild-install/**",

    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/*.ts",
    "!**/node_modules/**/*.map",
    "!**/node_modules/**/CHANGELOG*",
    "!**/node_modules/**/.github/**"
  ],
  "asarUnpack": [
    "**/node_modules/better-sqlite3/build/**",
    "**/node_modules/@napi-rs/keyring/**/*",
    "**/node_modules/onnxruntime-node/bin/**"
  ],
  "extraResources": [
    {
      "from": "src/assets",
      "to": "src/assets",
      "filter": [
        "**/*",
        "!Assets.car",
        "!icon.icns",
        "!icon.ico",
        "!openwhispr.icon/**",
        "!fonts/**",
        "!README.md"
      ]
    },
    {
      "from": "resources/bin/",
      "to": "bin/",
      "filter": [
        "ffmpeg*",
        "macos-audio-tap",
        "macos-globe-listener",
        "macos-fast-paste",
        "macos-mic-listener",
        "macos-text-monitor",
        "macos-media-remote",
        "linux-fast-paste",
        "linux-system-audio-helper",
        "linux-text-monitor",
        "linux-key-listener*",
        "windows-key-listener*",
        "windows-mic-listener*",
        "windows-text-monitor*",
        "windows-fast-paste*",
        "speech-vad/**/*",
        "*.dylib",
        "*.dll",
        "*.so*",
        "!libllama*",
        "!libggml*",
        "!libmtmd*",
        "!llama*",
        "!ggml*",
        "!mtmd*"
      ]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["dmg", "zip"],
    "icon": "src/assets/icon.icns",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "entitlements": "resources/mac/entitlements.mac.plist",
    "entitlementsInherit": "resources/mac/entitlements.mac.plist",
    "extraResources": [
      {
        "from": "resources/gigaam-model/",
        "to": "gigaam-model/",
        "filter": ["**/*"]
      }
    ],
    "extendInfo": {
      "LSUIElement": false,
      "NSMicrophoneUsageDescription": "Type uses the microphone to capture your voice for transcription.",
      "NSAudioCaptureUsageDescription": "Type uses system audio to capture other participants' audio from calls and meetings.",
      "NSAccessibilityUsageDescription": "Type needs accessibility permissions to paste transcribed text into other applications."
    }
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "src/assets/icon.ico",
    "extraResources": [
      {
        "from": "resources/bin/nircmd.exe",
        "to": "bin/nircmd.exe"
      }
    ]
  },
  "linux": {
    "target": ["AppImage", "deb", "rpm", "tar.gz"],
    "icon": "src/assets/icon.png",
    "category": "Utility",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "flatpak": {
    "runtime": "org.freedesktop.Platform",
    "runtimeVersion": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "useWaylandFlags": true,
    "finishArgs": [
      "--socket=wayland",
      "--socket=fallback-x11",
      "--share=network",
      "--share=ipc",
      "--device=dri",
      "--socket=pulseaudio",
      "--filesystem=home",
      "--filesystem=xdg-documents",
      "--filesystem=xdg-download",
      "--talk-name=org.freedesktop.Notifications",
      "--talk-name=org.freedesktop.portal.Desktop"
    ]
  },
  "deb": {
    "afterInstall": "resources/linux/after-install.sh",
    "afterRemove": "resources/linux/after-remove.sh",
    "depends": ["ydotool"],
    "fpm": [
      "--deb-recommends",
      "ydotoold",
      "--deb-suggests",
      "xdotool",
      "--deb-suggests",
      "wtype",
      "--deb-recommends",
      "wl-clipboard",
      "--deb-recommends",
      "xclip",
      "--deb-suggests",
      "xsel"
    ]
  },
  "rpm": {
    "fpm": [
      "--after-install",
      "resources/linux/after-install.sh",
      "--rpm-rpmbuild-define",
      "_build_id_links none",
      "--rpm-tag",
      "Requires: ydotool",
      "--rpm-tag",
      "Suggests: xdotool",
      "--rpm-tag",
      "Suggests: wtype",
      "--rpm-tag",
      "Recommends: wl-clipboard",
      "--rpm-tag",
      "Recommends: xclip",
      "--rpm-tag",
      "Suggests: xsel"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "include": "resources/nsis/cleanup-models.nsh"
  },
  "dmg": {
    "title": "Type",
    "format": "UDBZ",
    "icon": "src/assets/icon.icns",
    "window": {
      "width": 540,
      "height": 380
    }
  }
}
