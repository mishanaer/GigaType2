<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The protected-model helper stores its Secure Enclave key references and
         wrapped CEK cache in the Data Protection Keychain, which macOS only
         grants to processes with an application identifier. Without these two
         entitlements SecKeyCreateRandomKey fails with errSecMissingEntitlement
         (-34018) and protected activation is impossible. -->
    <key>com.apple.application-identifier</key>
    <string>LTS79DWRGJ.ai.gigatype.protected-gigaam</string>
    <key>keychain-access-groups</key>
    <array>
        <string>LTS79DWRGJ.ai.gigatype.protected-gigaam</string>
    </array>
</dict>
</plist>
