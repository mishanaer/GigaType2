# systemd-юнит stats-модуля GigaType (Traction, порт 9902 из projects.json).
# Установка: sudo cp stats-module.service /etc/systemd/system/stats-gigatype.service
#            sudo systemctl daemon-reload && sudo systemctl enable --now stats-gigatype
[Unit]
Description=Traction stats module: gigatype
After=network-online.target
Wants=network-online.target
# Прод-гейт: без drop-in с STATS_INGEST_TOKEN юнит не стартует — иначе
# забытый env.conf молча открыл бы ingest без токена (fail-open).
AssertPathExists=/etc/systemd/system/stats-gigatype.service.d/env.conf

[Service]
Type=simple
User=gigatool
Group=gigatool
WorkingDirectory=/srv/stats/gigatype/app
Environment=STATS_PORT=9902
Environment=STATS_DB=/srv/stats/gigatype/data/events.db
# Секреты — только через drop-in: /etc/systemd/system/stats-gigatype.service.d/env.conf
# (там STATS_INGEST_TOKEN=...). Для ручного/cron PostHog-backfill также нужны
# POSTHOG_PERSONAL_API_KEY и POSTHOG_PROJECT_ID; сервис сам их наружу не отдаёт.
# Помни готчу: EnvironmentFile переопределяет Environment.
ExecStart=/srv/stats/gigatype/app/.venv/bin/python /srv/stats/gigatype/app/server.py
Restart=always
RestartSec=3
# Изоляция соседей: один сбойный модуль не съедает хост (spec §3).
MemoryMax=1G
CPUQuota=50%
TasksMax=64
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
